---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.recent li {
				margin-bottom: 0.75em;
			}
			.recent .date {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Xin chào, tôi là Nguyễn Trung Kiên.</h1>
			<p>
				Đây là nơi tôi ghi lại những điều học được khi đưa AI và tự động hoá vào công việc hằng
				ngày: từ cách dùng trợ lý AI để chăm sóc khách hàng, vận hành doanh nghiệp vừa và nhỏ, cho
				đến những thử nghiệm công nghệ tôi đang làm.
			</p>
			<p>
				Tôi viết ngắn, có ví dụ thật, ưu tiên những gì có thể áp dụng ngay. Nếu bạn mới bắt đầu với
				AI, hãy đọc từ <a href="/blog">trang Blog</a>; muốn biết thêm về tôi, xem
				<a href="/about">trang Giới thiệu</a>.
			</p>

			<h2>Bài viết mới</h2>
			<ul class="recent">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<div class="date">
								<FormattedDate date={post.data.pubDate} />
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
